# Copia este archivo como .env y completa los valores. NUNCA subas .env a git.

# Seguridad (obligatorio en produccion): genera uno con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# PostgreSQL (docker-compose arma DATABASE_URL con esta clave)
POSTGRES_PASSWORD=cambia-esta-clave
# Para ejecutar sin Docker:
# DATABASE_URL=sqlite:///./omniflow.db

# OASIS ESPOCH. InfoGeneral/InfoCarrera responden sin credenciales de servicio;
# si la DTIC entrega un usuario de servicio, ponlo aqui (se envia en la cabecera SOAP).
OASIS_BASE_URL=http://swoasis.espoch.edu.ec/OASis/OAS_Interop/
OASIS_WS_USER=
OASIS_WS_PASSWORD=
# Al arrancar por primera vez, completa docentes/estudiantes/inscritos desde OASIS
OASIS_SYNC_ON_START=true

# Usuarios OASIS con rol ADMINISTRADOR (separados por coma)
ADMIN_USERS=

# Modo demostracion (login por rol sin OASIS). Ponlo en false en produccion.
DEMO_LOGIN_ENABLED=true
SEED_LABS=true
SEED_SCHEDULE=true

# Clave que deben enviar los telefonos en la cabecera X-Device-Key (vacio = sin clave)
DEVICE_API_KEY=

# Publicacion de actualizaciones de la app (./gradlew publishApk usa esta clave)
RELEASE_UPLOAD_KEY=
RELEASES_DIR=./releases

# Vision en el servidor
VISION_ENABLED=true
INSTALL_VISION=true
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.35
YOLO_DEVICE=cpu
VISION_SAMPLE_SECONDS=10

TIMEZONE=America/Guayaquil
CORS_ORIGINS=*

# Cloudflare Tunnel (perfil "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=
